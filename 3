        mensaje = "GO!" 
     
        nale = random.randint(0, 10000) 
        print(nale / 1000) 
     
        m = self.inicio + nale 
        ahora = time.ticks_ms() 
     
        contador = 0 
        anterior = 0 
        ultima = 0 
         
        while m > ahora: 
          actual = self.readKeys() 
          if anterior == 0 and actual == 128: 
                ahora = time.ticks_ms() 
                tiempo = time.ticks_diff(ahora, ultima) 
             
                if tiempo >= 50: 
                    contador = contador + 1 
                    print(contador) 
                    ultima = ahora 
                    mensaje1 = "FAIL" 
                    for i, let in enumerate(mensaje1): 
                        data = self.segmentos[let] 
                        address = i * 2 
                        self.sendData(address, data) 
                         
